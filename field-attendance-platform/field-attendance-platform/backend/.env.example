DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave DB_NAME empty to use SQLite locally
DB_NAME=field_attendance
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Leave empty for in-memory channel layer (single process only)
REDIS_URL=
# Server-controlled location tracking interval (seconds)
TRACKING_INTERVAL_SECONDS=30
