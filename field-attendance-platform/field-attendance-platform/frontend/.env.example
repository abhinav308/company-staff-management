VITE_API_URL=/api
VITE_WS_URL=

# Map Provider Configuration (Vector tiles with MapTiler or Stadia Maps)
# Leave blank to use built-in raster OpenStreetMap tiles (no API key required)
VITE_MAP_API_KEY=
# Optional style preset (e.g., 'streets-v2', 'dataviz', 'alidade-smooth', or direct style JSON URL)
VITE_MAP_STYLE=
