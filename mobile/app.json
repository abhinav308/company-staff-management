{
  "expo": {
    "name": "Ncode Field Attendance",
    "slug": "ncode-field-attendance",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ncodeattendance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ncodesolution.fieldattendance",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ncode Field Attendance requires location access to record your punch-in coordinates and verify field duty activity.",
        "NSCameraUsageDescription": "Ncode Field Attendance requires camera access to take your duty punch-in selfie.",
        "NSPhotoLibraryUsageDescription": "Allows uploading duty selfie from gallery."
      }
    },
    "android": {
      "package": "com.ncodesolution.fieldattendance",
      "adaptiveIcon": {
        "backgroundColor": "#ecfdf5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#059669"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ncode Field Attendance needs your location to record duty attendance and verify client visits."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ncode Field Attendance needs camera access to capture your duty punch-in selfie."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
