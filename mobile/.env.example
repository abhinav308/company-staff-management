# Django Backend REST API URL
# For physical devices running Expo Go on the same Wi-Fi network, use your PC's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.20.64:8000/api

# For Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# For iOS Simulator or Web:
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Feature flag for background tracking (requires Development Build with custom native code; default false for Expo Go)
EXPO_PUBLIC_FEATURE_BACKGROUND_TRACKING=false
